<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header', { activeNav: 'digest' }) %>
    <main>
        <p id="intro">"The Flyer" is a hub for North Oakland neighbors. All are welcome to <a href="/submit">contribute</a> ideas/events, or <a href="https://buttondown.com/theflyer" target="_blank" rel="noreferrer">subscribe</a> to the email newsletter.</p>
        <div id="carousel">
            <a href="/issues/nov-25"><img src="/static/img/nov25.jpg"></a>
            <img src="/static/img/oct25.jpg">
            <a href="/issues/sep-25"><img src="/static/img/sep25.jpg"></a>
            <a href="/issues/aug-25"><img src="/static/img/aug25.jpg"></a>
            <a href="/issues/jul-25"><img src="/static/img/jul25.jpg"></a>
        </div>
        <div class="issues">
            <% issues.forEach(issue => {
                const headlines = issue.posts.filter(p => p.title).map(p => p.title.toUpperCase() + ' • ').join(''); %>
            <a href="/issues/<%= issue.slug %>"><div class="issue" id="<%= issue.slug %>">
                <h3><%= issue.label %></h3>
                <p class="marq"><%= headlines.repeat(3) %></p>
            </div></a>
            <% }) %>
        </div>
        <div class="feed">
            <div class="issue-title"><h1>Recent Posts</h1></div>
            <% recentPosts.forEach(post => { %>
            <%- include('partials/post', { post, inIssue: false }) %>
            <% }) %>
            <p class="feed-more"><a href="/posts">See all posts →</a></p>
        </div>
    </main>
    <%- include('partials/scripts') %>
    <script>
        const carousel = document.getElementById('carousel');
        const images = carousel.querySelectorAll('img');
        function getRandomFloat(min, max) {
            return Math.random() * (max - min) + min;
        }
        images.forEach(img => {
            img.style.setProperty('--rotation', `${getRandomFloat(-3,3)}deg`);
        });
    </script>
</body>
</html>
